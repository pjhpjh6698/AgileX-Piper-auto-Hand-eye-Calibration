<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>piper_auto_handeye</name>
  <version>0.1.0</version>
  <description>Automatic Eye-in-Hand calibration for the Piper arm + RealSense (ArUco target).</description>
  <maintainer email="pjhpjh6698@gmail.com">jh</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>auto_handeye_interfaces</exec_depend>
  <!-- control_backend agx (real robot): the vendored AgileX ROS 2 driver -->
  <exec_depend>agx_arm_msgs</exec_depend>
  <exec_depend>agx_arm_ctrl</exec_depend>
  <!-- agx_arm_check talks to the SDK directly, bypassing the driver -->
  <exec_depend>pyagxarm_vendor</exec_depend>
  <!-- control_backend topic (simulation): mock_robot_node / Gazebo driver -->
  <exec_depend>piper_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <!-- view_calibration.launch.py: arm model + TF tree in RViz -->
  <exec_depend>agx_arm_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
